/// Estimates the maximum Y-axis tick label width for layout reservation
/// @param {numeric val} axisMin – Axis minimum value
/// @param {numeric val} axisMax – Axis maximum value
/// @param {int} [tickCount] – Optional: Number of ticks to estimate. Defaults to 1
/// @param {int} [axisFontSize] – Optional: Axis font size. Defaults to 10
/// @param {decimal} [labelWidthFactor] – Optional: Font width factor. Defaults to 0.56 (Segoe UI)
/// @param {boolean} [axisIsDate] – Optional: Whether the axis values represent dates. Defaults to FALSE
/// @returns {numeric} Estimated max label width in pixels
function 'DaxLib.SVG.Axes.MaxTickLabelWidth' =
		(
			axisMin: NUMERIC VAL,
			axisMax: NUMERIC VAL,
			tickCount: INT64 = 1,
			axisFontSize: INT64 = 10,
			labelWidthFactor: DOUBLE = 0.56,
			axisIsDate: BOOLEAN = FALSE()
		) =>

			VAR _NumericSpan = ABS( axisMax - axisMin )
			VAR _NumericDecimals = IF( _NumericSpan >= 100, 0, IF( _NumericSpan >= 10, 1, 2 ) )

			VAR _TickBase =
				ADDCOLUMNS(
					GENERATESERIES( 0, tickCount - 1, 1 ),
					"@TickValue",
						IF(
							tickCount = 1,
							axisMin,
							axisMin + DIVIDE( [Value], tickCount - 1, 0 ) * ( axisMax - axisMin )
						)
				)

			VAR _LabelTable =
				ADDCOLUMNS(
					_TickBase,
					"@Label",
						FORMAT(
							IF( axisIsDate, [@TickValue], ROUND( [@TickValue], _NumericDecimals )),
							IF( axisIsDate, "dd-mmm-yy", "General Number")
						)
				)

			VAR _MeasuredLabelTable =
				ADDCOLUMNS(
					_LabelTable,
					"@EstimatedWidth", LEN( [@Label] ) * axisFontSize * labelWidthFactor
				)

			RETURN
				MAXX( _MeasuredLabelTable, [@EstimatedWidth] )

	annotation DAXLIB_PackageId = __PLACEHOLDER_PACKAGE_ID__

	annotation DAXLIB_PackageVersion = __PLACEHOLDER_PACKAGE_VERSION__
