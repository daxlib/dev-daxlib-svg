/// Renders a bar chart as an SVG data URI showing measure values across an axis
/// @param {anyref expr} axisRef – Axis reference column
/// @param {numeric expr} measureRef – Measure expression
/// @param {string} [color] – Optional series color. Defaults to theme color
/// @param {string} [minMarkColor] – Optional: The hex color for the minimum value bar
/// @param {string} [maxMarkColor] – Optional: The hex color for the maximum value bar
/// @param {boolean} [showAxis] – Optional axis toggle. Defaults to FALSE
/// @param {int} [width] – Optional: SVG width. Defaults to 120
/// @param {int} [height] – Optional: SVG height. Defaults to 48
/// @returns {string} SVG Bar Chart
function 'DaxLib.SVG.Viz.Bars' =
		(
			axisRef: ANYREF EXPR,
			measureRef: NUMERIC EXPR,
			color: STRING = BLANK(),
			minMarkColor: STRING = BLANK(),
			maxMarkColor: STRING = BLANK(),
			showAxis: BOOLEAN = FALSE(),
			width: INT64 = 120,
			height: INT64 = 48
		) =>

			VAR _Marks =
				DaxLib.SVG.Compound.Bars(
					0, 
                    0, 
                    width, 
                    height,
					axisRef,
                    measureRef,
					color, 
                    minMarkColor, 
                    maxMarkColor, 
                    showAxis
				)

			RETURN
				IF( NOT ISBLANK( _Marks ), DaxLib.SVG.SVG( "100%", "100%", _Marks, "0 0 " & width & " " & height ) )

	annotation DAXLIB_PackageId = __PLACEHOLDER_PACKAGE_ID__

	annotation DAXLIB_PackageVersion = __PLACEHOLDER_PACKAGE_VERSION__
