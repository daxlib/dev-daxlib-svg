/// Create a pill SVG compound (rounded rectangle with auto-sized text centered inside)
/// @param {int} x – The x position of compound
/// @param {int} y – The y position of compound
/// @param {int} width – The width of the compound
/// @param {int} height – The height of the compound
/// @param {string} txt – The text to display
/// @param {string} [color] – Optional: The hex color of the pill, e.g., "#01B8AA80". Defaults to "#01B8AA"
/// @param {decimal} [paddingX] – Optional: The horizontal padding percentage (0.0-1.0, e.g., 0.1 = 10% padding). Defaults to 0.05
/// @param {decimal} [paddingY] – Optional: The vertical padding percentage (0.0-1.0, e.g., 0.1 = 10% padding). Defaults to 0.02
/// @returns {string} SVG Pill
function 'DaxLib.SVG.Compound.Pill' = 
		(
			x: INT64,
			y: INT64,
			width: INT64,
			height: INT64,
			txt: STRING,
			color: STRING = BLANK(),
			paddingX: DOUBLE = 0.05,
			paddingY: DOUBLE = 0.02
		) =>

		// Apply padding to dimensions
		VAR _X = 			x + (width * (IF(ISBLANK(paddingX), 0, paddingX) / 2))
		VAR _Y = 			y + (height * (IF(ISBLANK(paddingY), 0, paddingY) / 2))
		VAR _Width = 		width * (1 - IF(ISBLANK(paddingX), 0, paddingX))
		VAR _Height = 		height * (1 - IF(ISBLANK(paddingY), 0, paddingY))

		VAR _Color = IF( NOT ISBLANK( color ), color, "#01B8AA" )

		VAR _Pill = 
			DaxLib.SVG.Element.Rect(
				_X,
				_Y,
				_Width * 0.98,
				_Height * 0.92,
				10,
				10,
				DaxLib.SVG.Attr.Shapes(
					_Color,
					0.2,
					BLANK(),
					_Color,
					1
				)
			)

		// Auto-size font to fit text within pill
		VAR _AvailableWidth = _Width * 0.90
		VAR _CharWidthRatio = 0.55
		VAR _TextWidthAtOne = LEN( txt ) * _CharWidthRatio
		VAR _MaxFontFromWidth = IF( _TextWidthAtOne > 0, _AvailableWidth / _TextWidthAtOne, 12 )
		VAR _MaxFontFromHeight = _Height * 0.75
		VAR _FontSize = MAX( 4, MIN( 12, MIN( _MaxFontFromWidth, _MaxFontFromHeight ) ) )

		VAR _TextElement = 
			DaxLib.SVG.Element.Txt(
				_X + (_Width * 0.50),
				_Y + (_Height * 0.58),
				txt,
				0,
				0,
				DaxLib.SVG.Attr.Shapes( _Color ) &
				DaxLib.SVG.Attr.Txt(
					"Segoe UI",
					_FontSize,
					BLANK(),
					BLANK(),
					"middle",
					"middle"
				)
			)

		VAR _CombinedElements = 
			_Pill & 
			_TextElement

		RETURN
		
			IF( NOT ISBLANK( txt ), _CombinedElements )

	annotation DAXLIB_PackageId = __PLACEHOLDER_PACKAGE_ID__

	annotation DAXLIB_PackageVersion = __PLACEHOLDER_PACKAGE_VERSION__
